{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
      { "src": "^/registrar/?$", "dest": "/api/registrar/index.php" },
  { "src": "^/registrar/(.*)$", "dest": "/api/registrar/$1" },
    { "src": "^/css/(.*)$", "dest": "/public/css/$1" },
    { "src": "^/login\\.php$", "dest": "/api/login.php" },
    { "src": "^/logout\\.php$", "dest": "/api/logout.php" },
    { "src": "^/register\\.php$", "dest": "/api/register.php" },
    { "src": "^/admin/?$", "dest": "/api/admin/index.php" },
    { "src": "^/admin/(.*)$", "dest": "/api/admin/$1" },
    { "src": "^/user/?$", "dest": "/api/user/index.php" },
    { "src": "^/user/(.*)$", "dest": "/api/user/$1" },
    { "src": "^/(.*)$", "dest": "/api/index.php" }
  ]
}